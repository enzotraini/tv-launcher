<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Enxerga apps com tela e os pacotes oficiais que o launcher abre. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.suspension" />
        <package android:name="com.android.tv.settings" />
        <package android:name="com.google.android.tv" />
        <package android:name="com.netflix.ninja" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.globo.globotv" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.stremio.one" />
        <package android:name="br.com.band.guiatv" />
        <package android:name="br.com.sbt.mais" />
        <package android:name="com.mobilus.recordplay.tv" />
        <package android:name="com.mobilus.recordplay" />
        <package android:name="tv.pluto.android" />
        <package android:name="com.plexapp.android" />
        <package android:name="org.libreflix.app" />
        <package android:name="com.eitv.spcineplay" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.cbs.ott" />
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.google.android.videos" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:enableOnBackInvokedCallback="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParaVoce">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density|locale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InputsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape" />

        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape" />

        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".WallpapersActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape" />

        <activity
            android:name=".AmbientActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.ParaVoce.Night" />

        <service
            android:name=".ambient.AmbientDream"
            android:exported="true"
            android:label="@string/ambient_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/ambient_dream" />
        </service>
    </application>
</manifest>
