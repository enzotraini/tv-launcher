<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/poster_root"
    android:layout_width="@dimen/poster_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/poster_gap"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="3dp">

    <FrameLayout
        android:id="@+id/poster_frame"
        android:layout_width="match_parent"
        android:layout_height="@dimen/poster_height"
        android:duplicateParentState="true"
        android:foreground="@drawable/focus_ring">

        <dev.enzotraini.tvlauncher.ui.PosterArt
            android:id="@+id/poster_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/poster_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/poster_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="12sp" />
</LinearLayout>
