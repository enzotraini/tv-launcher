<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="26dp"
        android:paddingEnd="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:text="@string/for_you"
                android:textColor="@color/ink"
                android:textSize="40sp" />

            <LinearLayout
                android:id="@+id/tab_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/icon_cluster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/cast_button"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:background="@drawable/icon_button_bg"
                android:clickable="true"
                android:contentDescription="@string/cast_cd"
                android:elevation="3dp"
                android:focusable="true"
                android:foreground="@drawable/focus_circle">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cast" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/edit_button"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:layout_marginStart="10dp"
                android:background="@drawable/icon_button_bg"
                android:clickable="true"
                android:contentDescription="@string/edit_cd"
                android:elevation="3dp"
                android:focusable="true"
                android:foreground="@drawable/focus_circle">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_edit" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/settings_button"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:layout_marginStart="10dp"
                android:background="@drawable/icon_button_bg"
                android:clickable="true"
                android:contentDescription="@string/entradas_cd"
                android:elevation="3dp"
                android:focusable="true"
                android:foreground="@drawable/focus_circle">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_settings" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/featured_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="6dp" />

    <HorizontalScrollView
        android:id="@+id/dock_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:focusable="false"
        android:overScrollMode="never"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/dock_pill"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:outlineProvider="background"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/dock_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
