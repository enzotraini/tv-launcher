<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="64dp"
    android:paddingEnd="64dp">

    <FrameLayout
        android:id="@+id/detail_frame"
        android:layout_width="300dp"
        android:layout_height="450dp"
        android:background="@drawable/poster_surface"
        android:elevation="10dp">

        <dev.enzotraini.tvlauncher.ui.RoundedImageView
            android:id="@+id/detail_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/detail_kind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter_bold"
            android:includeFontPadding="false"
            android:textColor="@color/ink"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/detail_blurb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_regular"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/inter_regular"
            android:text="@string/detail_footnote"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
